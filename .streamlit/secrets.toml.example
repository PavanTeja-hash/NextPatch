# NextPatch secrets - TEMPLATE. Both keys are OPTIONAL; the app runs without them.
#
# LOCAL:  copy this file to  .streamlit/secrets.toml  and fill in your keys.
# DEPLOY: paste these lines into your host's "Secrets" panel
#         (e.g. Streamlit Community Cloud → app → Settings → Secrets).
#
# NEVER commit the real secrets.toml - it is git-ignored for you.

# Enables the AI explanation features (Google Gemini). Without it, the tool
# still fetches, scores and ranks - the AI panels are just hidden.
GEMINI_API_KEY = "paste-your-gemini-key-here"

# Optional: raises NVD's rate limit from 5 to 50 requests / 30s. Only matters
# for brand-new CVEs a user types in; the demo is pre-cached and needs nothing.
# NVD_API_KEY = "paste-your-nvd-key-here"

# Optional: override the Gemini model (defaults to gemini-flash-latest).
# GEMINI_MODEL = "gemini-flash-latest"
